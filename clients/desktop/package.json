{
  "name": "qingyu-assistant-desktop",
  "productName": "青屿助手",
  "version": "0.1.0",
  "private": true,
  "description": "青屿助手桌面宿主",
  "main": "src/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/policy.test.cjs tests/workbench.test.cjs tests/companion.test.cjs",
